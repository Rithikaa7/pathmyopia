# PathMyo Retinal AI Research Workspace Configuration

# Inference Backend API endpoint (e.g. FastAPI/PyTorch inference service)
# Leave empty or set to 'mock' for standalone research demo mode
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Default research mode: 'demo' | 'connected'
VITE_DEFAULT_MODE=demo

# Active Foundation Model Identifier
VITE_MODEL_NAME=RETFound-MultiTask

# Checkpoint Path reference
VITE_CHECKPOINT_PATH=pm_results/pm_research/multitask/best.pth
